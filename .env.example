# Settings for the backend. Locally/VPS: copy to .env and fill in (never commit .env).
# On Vercel: add these under Project → Settings → Environment Variables instead.

# Public site address, used in emails, canonical URLs and the blog sitemap.
BASE_URL=https://www.resurgentlegal.com

# Database. Set on Vercel automatically when you connect a Neon (Postgres) database.
# Leave empty locally/VPS to use a SQLite file in DATA_DIR.
DATABASE_URL=

# Blog image storage. Set on Vercel automatically when you connect a Blob store.
# Leave empty locally/VPS to save images in DATA_DIR/uploads.
BLOB_READ_WRITE_TOKEN=

# First administrator, created on start-up if there are no users yet (the easiest way on Vercel).
# Use a strong password (10+ characters), sign in, then change it under "My account".
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# New-lead email alerts. Google Workspace: smtp.gmail.com, port 587, an app password.
# Zoho Mail: smtp.zoho.in, port 587 (or 465 with SMTP_SECURE=1).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Resurgent Legal Website <corporate@resurgentlegal.com>"
LEAD_ALERT_TO=corporate@resurgentlegal.com

# --- VPS only ---------------------------------------------------------------
# NODE_ENV=production          # secure cookies, trusts nginx, does not serve the static site
# PORT=3000
# HOST=127.0.0.1
# SITE_DIR=/var/www/resurgentlegal   # folder holding index.html and assets/
# DATA_DIR=/var/lib/resurgentlegal   # SQLite database and uploaded images
