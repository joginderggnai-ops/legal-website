{
  "name": "resurgent-legal-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Leads inbox, blog and admin panel for the Resurgent Legal LLP website",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "create-user": "node --env-file-if-exists=.env scripts/create-user.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "multer": "2.4.0",
    "nodemailer": "10.1.1",
    "quill": "2.0.2",
    "sanitize-html": "2.18.0"
  }
}
