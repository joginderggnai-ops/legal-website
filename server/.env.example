# Copy to .env and fill in. Never commit .env.

# "production" on the VPS (secure cookies, trusts nginx, does not serve the static site).
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Public site address, used in emails, canonical URLs and the blog sitemap.
BASE_URL=https://www.resurgentlegal.com

# Folder holding index.html and assets/ (default: the folder above server/).
# SITE_DIR=/var/www/resurgentlegal
# Where the database and uploaded images are stored (default: server/data).
# DATA_DIR=/var/lib/resurgentlegal

# New-lead email alerts. Google Workspace: smtp.gmail.com, port 587, an app password.
# Zoho Mail: smtp.zoho.in, port 587 (or 465 with SMTP_SECURE=1).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Resurgent Legal Website <corporate@resurgentlegal.com>"
LEAD_ALERT_TO=corporate@resurgentlegal.com
